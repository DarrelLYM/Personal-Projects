rules_version = '2';
// Paste these into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person can read and write only their own profile and food log.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /months/{month} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Username -> email lookup, so people can sign in with a username.
    // Anyone can look up a username; only its owner can create, update or delete it; nobody can take over an existing one.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // The owner can update the stored email after changing it; nobody can move a username to another account.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email']);
    }
  }
}
